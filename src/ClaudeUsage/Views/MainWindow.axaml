<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClaudeUsage.ViewModels"
        x:Class="ClaudeUsage.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Claude Usage"
        Icon="/Assets/icon.ico"
        Width="460" SizeToContent="Height"
        MinWidth="380" MinHeight="200"
        FontFamily="fonts:Inter#Inter">

  <Window.Resources>
    <SolidColorBrush x:Key="CardBrush" Color="#1A1F33" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2A3050" />
    <SolidColorBrush x:Key="TrackBrush" Color="#2B3150" />
    <SolidColorBrush x:Key="TextBrush" Color="#F1F3FA" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9AA3C0" />
    <SolidColorBrush x:Key="TimeBrush" Color="#6C8CFF" />
  </Window.Resources>

  <Window.Background>
    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#0B1020" />
      <GradientStop Offset="1" Color="#161A30" />
    </LinearGradientBrush>
  </Window.Background>

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="Margin" Value="0,0,0,14" />
      <Setter Property="BoxShadow" Value="0 8 24 0 #40000000" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.setting">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,16,0" />
    </Style>
    <Style Selector="ComboBox.setting">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style Selector="TextBlock.big">
      <Setter Property="FontSize" Value="42" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.big.time">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="Margin" Value="0,7,0,7" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Height" Value="10" />
      <Setter Property="MinHeight" Value="10" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Background" Value="{StaticResource TrackBrush}" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="18">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="2,0,2,16">
      <TextBlock Text="Claude Usage" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Refresh" Click="OnRefreshClick"
              IsEnabled="{Binding !IsBusy}" CornerRadius="8" Padding="14,6" />
      <ToggleButton Grid.Column="2" IsChecked="{Binding IsSettingsOpen}"
                    ToolTip.Tip="Settings" CornerRadius="8" Padding="8,6" Margin="8,0,0,0">
        <Path Width="18" Height="18" Stretch="Uniform" Fill="{StaticResource TextBrush}"
              Data="F0 M19.43,10.40 L22.41,10.60 L22.41,13.40 L19.43,13.60 L18.38,16.12 L20.35,18.37 L18.37,20.35 L16.12,18.38 L13.60,19.43 L13.40,22.41 L10.60,22.41 L10.40,19.43 L7.88,18.38 L5.63,20.35 L3.65,18.37 L5.62,16.12 L4.57,13.60 L1.59,13.40 L1.59,10.60 L4.57,10.40 L5.62,7.88 L3.65,5.63 L5.63,3.65 L7.88,5.62 L10.40,4.57 L10.60,1.59 L13.40,1.59 L13.60,4.57 L16.12,5.62 L18.37,3.65 L20.35,5.63 L18.38,7.88 Z M15.5,12 A3.5,3.5 0 1 0 8.5,12 A3.5,3.5 0 1 0 15.5,12 Z" />
      </ToggleButton>
    </Grid>

    <Border Grid.Row="1" Classes="card" IsVisible="{Binding IsSettingsOpen}">
      <StackPanel Spacing="12">
        <TextBlock Classes="title" Text="Settings" />
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Classes="setting" Text="Show" />
          <ComboBox Grid.Row="0" Grid.Column="1" Classes="setting"
                    ItemsSource="{Binding DisplayChoices}"
                    SelectedItem="{Binding SelectedDisplay}" />
          <TextBlock Grid.Row="1" Classes="setting" Text="Tray icon shows" />
          <ComboBox Grid.Row="1" Grid.Column="1" Classes="setting"
                    ItemsSource="{Binding TrayChoices}"
                    SelectedItem="{Binding SelectedTray}" />
          <TextBlock Grid.Row="2" Classes="setting" Text="Refresh" />
          <ComboBox Grid.Row="2" Grid.Column="1" Classes="setting"
                    ItemsSource="{Binding RefreshChoices}"
                    SelectedItem="{Binding SelectedRefresh}" />
        </Grid>
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Limits}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LimitCardViewModel">
            <Border Classes="card">
              <StackPanel Spacing="12">

                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Classes="muted" Text="{Binding ResetText}"
                             VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto,*" Margin="0,6,0,2">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Classes="label" Text="{Binding PrimaryLabel}" />
                    <TextBlock Classes="big" Text="{Binding PrimaryText}"
                               Foreground="{Binding AccentBrush}" />
                  </StackPanel>
                  <Border Grid.Column="1" Width="1" Margin="0,4"
                          Background="{StaticResource CardBorderBrush}" />
                  <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Classes="label" Text="Time Left" />
                    <TextBlock Classes="big time" Text="{Binding TimeLeftText}"
                               Foreground="{StaticResource TimeBrush}" />
                  </StackPanel>
                </Grid>

                <StackPanel Spacing="5">
                  <TextBlock Classes="muted" Text="{Binding PrimaryLabel}" />
                  <ProgressBar Value="{Binding PrimaryPercent}"
                               Foreground="{Binding AccentBrush}" />
                </StackPanel>

                <StackPanel Spacing="5">
                  <TextBlock Classes="muted" Text="Time Left" />
                  <ProgressBar Value="{Binding TimeLeftPercent}"
                               Foreground="{StaticResource TimeBrush}" />
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                  <TextBlock Classes="muted" Text="{Binding SecondaryText}" />
                  <TextBlock Grid.Column="1" Text="{Binding ResetAtText}"
                             FontSize="13" FontWeight="SemiBold" />
                </Grid>

              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock Grid.Row="3" Classes="muted" Text="{Binding StatusText}"
               TextWrapping="Wrap" Margin="2,8,2,0" />
  </Grid>
</Window>
